# ── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Mapbox (akun Education) — token PUBLIC, URL-restricted ──────
NEXT_PUBLIC_MAPBOX_TOKEN=""
# Tileset IDs hasil upload Mapbox Studio (WPP/EEZ/MPA)
NEXT_PUBLIC_MAPBOX_TILESET_WPP=""
NEXT_PUBLIC_MAPBOX_WPP_SOURCE_LAYER="wpp_zones"
NEXT_PUBLIC_MAPBOX_TILESET_EEZ=""
NEXT_PUBLIC_MAPBOX_EEZ_SOURCE_LAYER="eez"
NEXT_PUBLIC_MAPBOX_TILESET_MPA=""
NEXT_PUBLIC_MAPBOX_MPA_SOURCE_LAYER="mpa"

# ── Supabase (Realtime subscribe dari browser) ──────────────────
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── Proxy target — dipakai next.config.ts rewrites ──────────────
# prod (Vercel env): https://api.<domain-vps>
API_BASE_URL="http://localhost:4000"
