# ── Database (Supabase) ─────────────────────────────────────────
# Pooler (runtime, port 6543) — Supabase Dashboard → Connect → Transaction pooler
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (migration, port 5432)
DIRECT_URL="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres"

# ── Auth ────────────────────────────────────────────────────────
# generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# = origin FRONTEND (cookie via proxy rewrites). Dev: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"
# Optional comma-separated frontend production origins accepted for auth mutations.
# Example: "https://siren.example.com,https://www.siren.example.com"
BETTER_AUTH_TRUSTED_ORIGINS=""

# ── Google AI Studio (GRATIS — aistudio.google.com, BUKAN subscription Gemini Pro student) ──
GOOGLE_GENERATIVE_AI_API_KEY=""

# ── Mapbox server (Static Images API untuk PDF) ─────────────────
MAPBOX_SECRET_TOKEN=""

# ── Global Fishing Watch API v3 ─────────────────────────────────
GFW_API_TOKEN=""

# ── Supabase server (Storage upload, service role — JANGAN bocor ke client) ──
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ── App ─────────────────────────────────────────────────────────
PORT="4000"
# Interface bind. Default 127.0.0.1 — API tidak boleh terekspos publik;
# di produksi nginx yang meneruskan trafik.
HOST="127.0.0.1"
NODE_ENV="development"

# pasal.id personal access token — buat di https://pasal.id/akun
PASAL_API_TOKEN=""
